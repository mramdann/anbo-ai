{
  "manifest_version": 3,
  "name": "Anbo Browser Bridge (Development Preview)",
  "version": "0.4.9",
  "key": "",
  "description": "Explicitly connect a Chrome or Edge profile and selected tabs to Anbo.",
  "minimum_chrome_version": "125",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "permissions": ["debugger", "nativeMessaging", "storage", "tabs"],
  "incognito": "not_allowed",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Anbo Browser Bridge",
    "default_popup": "popup.html",
    "default_icon": { "16": "icon-16.png", "24": "icon-24.png", "32": "icon-32.png" }
  }
}
