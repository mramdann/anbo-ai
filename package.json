  "scripts": {
    "dev": "vite",
    "dev:inspect": "INSPECT=true vite",
    "build": "tsc && vite build",
    "smoke:production": "node scripts/production-smoke.mjs",
    "build:app": "pnpm build && pnpm prepare:browser-sidecar",
    "preview": "vite preview",
    "prepare:browser-sidecar": "node scripts/prepare-browser-sidecar.mjs",
    "tauri": "tauri",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check-version": "node scripts/check-version-sync.mjs",
    "check:native-patches": "node scripts/check-native-patches.mjs",
    "check-types": "tsc --noEmit",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src",
    "analyze:bundle": "ANALYZE=true vite build",
    "analyze:eager": "node scripts/eager-graph.mjs src/main.tsx && node scripts/eager-graph.mjs src/settings/main.tsx",
    "benchmark:browser-frames": "node scripts/browser-frame-benchmark.mjs",
    "benchmark:browser-bridge": "node scripts/browser-bridge-benchmark.mjs",
    "generate:material-icons": "node scripts/generate-material-icon-set.mjs",
    "size": "size-limit && node scripts/startup-budget.mjs",
    "size:startup": "node scripts/startup-budget.mjs",
    "knip": "knip"
  },
