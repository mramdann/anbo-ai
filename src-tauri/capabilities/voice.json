{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "voice",
  "description": "Capability for the global AnboVoice overlay",
  "windows": [
    "voice"
  ],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "core:window:allow-available-monitors",
    "log:default",
    "store:default"
  ]
}
