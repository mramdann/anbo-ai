{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/settings/main.tsx",
    "src/voice/main.tsx",
    "src/modules/lsp/lib/protocolShim.ts",
    "scripts/*.mjs",
    "src/styles/globals.css"
  ],
  "project": ["src/**/*.{ts,tsx,css}"],
  "ignoreIssues": {
    "src/components/ui/**": ["exports", "types"],
    "src/components/ai-elements/**": ["exports", "types"]
  },
  "ignoreBinaries": ["rustc"],
  "ignoreDependencies": ["@fontsource/jetbrains-mono", "@fontsource-variable/inter"]
}
